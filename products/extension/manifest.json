{
  "manifest_version": 3,
  "name": "LeftOut WebMCP Safety",
  "version": "0.3.0",
  "description": "Shows WebMCP activity and guards one exact, document-bound action through the local connector.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8788/*",
    "http://localhost:8788/*",
    "http://127.0.0.1:48788/*",
    "http://localhost:48788/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open WebMCP safety",
    "default_popup": "popup.html"
  }
}
